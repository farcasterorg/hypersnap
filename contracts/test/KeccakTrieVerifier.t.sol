pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {KeccakTrieVerifier} from "../src/KeccakTrieVerifier.sol";

/// Checks KeccakTrieVerifier against the hypersnap-ktrie fixture
/// (crates/hypersnap-ktrie/testdata/vectors.json). The vector block at the end
/// is generated by the crate's fixture test from the same data as the JSON
/// (foundry.toml grants read access only inside this project, so the vectors
/// are embedded rather than read with vm.readFile). Regenerate with
/// `KTRIE_REGEN=1 cargo test --test fixture` in crates/hypersnap-ktrie; that
/// test fails if this block is stale.
contract KeccakTrieVerifierTest is Test {
    struct Vector {
        string name;
        bytes32 root;
        bool raw; // key/value are real preimages of path/valueHash
        bytes key;
        bytes value;
        bytes32 path;
        bool hasValue;
        bytes32 valueHash;
        bytes proof;
        bool valid;
    }

    /// Verify through the hashed entry point and, for raw vectors, through
    /// the key/value entry points too (they must agree).
    function _check(Vector memory v, bytes memory proof) internal pure returns (bool) {
        bool hashed = KeccakTrieVerifier.verify(v.root, v.path, v.hasValue, v.valueHash, proof);
        if (v.raw) {
            bool viaRaw = v.hasValue
                ? KeccakTrieVerifier.verifyInclusion(v.root, v.key, v.value, proof)
                : KeccakTrieVerifier.verifyNonInclusion(v.root, v.key, proof);
            require(viaRaw == hashed, "raw and hashed entry points disagree");
        }
        return hashed;
    }

    function test_FixtureVectors() public pure {
        Vector[] memory v = _vectors();
        uint256 valid;
        for (uint256 i = 0; i < v.length; i++) {
            if (v[i].raw) {
                assertEq(keccak256(v[i].key), v[i].path, v[i].name);
                if (v[i].hasValue) assertEq(keccak256(v[i].value), v[i].valueHash, v[i].name);
            }
            assertEq(_check(v[i], v[i].proof), v[i].valid, v[i].name);
            if (v[i].valid) valid++;
        }
        assertGt(valid, 20);
    }

    function test_EverySingleByteTamperFails() public pure {
        Vector[] memory v = _vectors();
        for (uint256 i = 0; i < v.length; i++) {
            if (!v[i].valid) continue;
            bytes memory p = v[i].proof;
            for (uint256 j = 0; j < p.length; j++) {
                bytes1 orig = p[j];
                p[j] = orig ^ 0x01;
                assertFalse(_check(v[i], p), v[i].name);
                p[j] = orig ^ 0x80;
                assertFalse(_check(v[i], p), v[i].name);
                p[j] = orig;
            }
            // Extended by one zero byte, then truncated by one byte (in place;
            // `p` aliases `v[i].proof`).
            assertFalse(_check(v[i], bytes.concat(p, hex"00")), v[i].name);
            uint256 len = p.length;
            assembly ("memory-safe") {
                mstore(p, sub(len, 1))
            }
            assertFalse(_check(v[i], p), v[i].name);
            assembly ("memory-safe") {
                mstore(p, len)
            }
            assertTrue(_check(v[i], p), v[i].name);
        }
    }

    function test_EmptyAndSingleLeafTries() public pure {
        // Empty trie: root 0, proof = kind 0x01, D = 0.
        assertTrue(KeccakTrieVerifier.verifyNonInclusion(bytes32(0), "any", hex"010000"));
        assertFalse(KeccakTrieVerifier.verifyInclusion(bytes32(0), "any", "", hex"000000"));
        // One key: root = its leaf hash, proof = kind 0x00, D = 0.
        bytes32 root = KeccakTrieVerifier.leafHash(keccak256("k"), keccak256("v"));
        assertTrue(KeccakTrieVerifier.verifyInclusion(root, "k", "v", hex"000000"));
        assertFalse(KeccakTrieVerifier.verifyInclusion(root, "k", "w", hex"000000"));
        assertEq(keccak256(""), 0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470);
    }

    /// Gas of the hashed entry point for each valid inclusion vector (-vv).
    function test_GasInclusion() public {
        Vector[] memory v = _vectors();
        for (uint256 i = 0; i < v.length; i++) {
            if (!v[i].valid || !v[i].hasValue) continue;
            uint256 g = gasleft();
            bool ok = KeccakTrieVerifier.verify(v[i].root, v[i].path, true, v[i].valueHash, v[i].proof);
            uint256 used = g - gasleft();
            assertTrue(ok, v[i].name);
            emit log_named_uint(v[i].name, used);
        }
    }

